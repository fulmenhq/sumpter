{
  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",
  \"title\": \"Sumpter Dialect Registry\",
  \"type\": \"object\",
  \"description\": \"Registry of XML dialects for detection, with extensions for private blending\",
  \"required\": [\"registry_version\", \"last_updated\", \"dialects\"],
  \"properties\": {
    \"registry_version\": {
      \"type\": \"string\",
      \"description\": \"Version of the registry\",
      \"pattern\": \"^v[0-9]+\\.[0-9]+\\.[0-9]+(-alpha)?$\"
    },
    \"last_updated\": {
      \"type\": \"string\",
      \"description\": \"ISO 8601 date of last update\",
      \"format\": \"date-time\"
    },
    \"dialects\": {
      \"type\": \"array\",
      \"description\": \"Array of dialect definitions\",
      \"items\": {
        \"type\": \"object\",
        \"required\": [\"dialect_id\", \"name\", \"description\", \"status\", \"priority\", \"realm\", \"patterns\"],
        \"properties\": {
          \"dialect_id\": {
            \"type\": \"string\",
            \"description\": \"Unique identifier for the dialect\",
            \"pattern\": \"^[a-z0-9-]+$\"
          },
          \"name\": {
            \"type\": \"string\",
            \"description\": \"Human-readable name of the dialect\"
          },
          \"description\": {
            \"type\": \"string\",
            \"description\": \"Detailed description of the dialect\"
          },
          \"status\": {
            \"type\": \"string\",
            \"enum\": [\"active\", \"development\", \"deprecated\"],
            \"description\": \"Current status of the dialect\"
          },
          \"priority\": {
            \"type\": \"string\",
            \"enum\": [\"high\", \"medium\", \"low\"],
            \"description\": \"Detection priority level\"
          },
          \"realm\": {
            \"type\": \"string\",
            \"enum\": [\"retail\", \"finance\", \"healthcare\", \"environment\", \"legal\", \"general\"],
            \"description\": \"Alignment to PracticingData realms (extensible)\"
          },
          \"patterns\": {
            \"type\": \"array\",
            \"description\": \"Detection patterns for elements/attributes/etc.\",
            \"minItems\": 1,
            \"items\": {
              \"type\": \"object\",
              \"required\": [\"pattern_id\", \"name\", \"selector\", \"weight\", \"ecosystem\"],
              \"properties\": {
                \"pattern_id\": {
                  \"type\": \"string\",
                  \"description\": \"Unique ID for the pattern\"
                },
                \"name\": {
                  \"type\": \"string\",
                  \"description\": \"Pattern name\"
                },
                \"selector\": {
                  \"type\": \"string\",
                  \"description\": \"XPath-like selector (e.g., local-name()='metar')\""
                },
                \"weight\": {
                  \"type\": \"number\",
                  \"minimum\": 0,
                  \"maximum\": 1,
                  \"description\": \"Match weight (0-1)\"
                },
                \"ecosystem\": {
                  \"type\": \"string\",
                  \"description\": \"Sub-domain ecosystem (e.g., 'telemetry')\"
                }
              },
              \"additionalProperties\": false
            }
          },
          \"xml_standards\": {
            \"type\": \"array\",
            \"items\": { \"type\": \"string\" },
            \"description\": \"Applicable XML standards/XSDs\"
          },
          \"data_sensitivity\": {
            \"type\": \"string\",
            \"enum\": [\"low\", \"medium\", \"high\", \"privileged\"],
            \"description\": \"Default sensitivity level\"
          },
          \"bridge_dialects\": {
            \"type\": \"array\",
            \"description\": \"Bridges to other dialects/realms\",
            \"items\": {
              \"type\": \"object\",
              \"required\": [\"target_dialect\", \"bridge_type\", \"description\", \"bridge_keys\"],
              \"properties\": {
                \"target_dialect\": { \"type\": \"string\" },
                \"bridge_type\": { \"type\": \"string\", \"enum\": [\"transaction\", \"data_flow\", \"attribute-shared\"] },
                \"description\": { \"type\": \"string\" },
                \"bridge_keys\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }
              },
              \"additionalProperties\": false
            }
          },
          \"tags\": {
            \"type\": \"array\",
            \"items\": { \"type\": \"string\" },
            \"description\": \"Keywords for search/filtering\"
          },
          \"use_cases\": {
            \"type\": \"array\",
            \"items\": { \"type\": \"string\" },
            \"description\": \"Example use cases\"
          },
          \"examples\": {
            \"type\": \"array\",
            \"description\": \"Sample files/paths\",
            \"items\": {
              \"type\": \"object\",
              \"required\": [\"path\", \"description\"],
              \"properties\": {
                \"path\": { \"type\": \"string\" },
                \"description\": { \"type\": \"string\" }
              },
              \"additionalProperties\": false
            }
          },
          \"confidence_threshold\": {
            \"type\": \"number\",
            \"minimum\": 0,
            \"maximum\": 1,
            \"default\": 0.7,
            \"description\": \"Minimum confidence for detection\"
          },
          \"format_type\": {
            \"type\": \"string\",
            \"enum\": [\"xml\", \"json\", \"protobuf\"],
            \"default\": \"xml\",
            \"description\": \"Primary format (stub for multi-format)\"
          }
        },
        \"additionalProperties\": false
      },
      \"uniqueItems\": true,
      \"minItems\": 1
    },
    \"extensions\": {
      \"type\": \"array\",
      \"description\": \"Extensions for blending/override/replace (private/public)\",
      \"items\": {
        \"type\": \"object\",
        \"required\": [\"type\", \"source\", \"version\"],
        \"properties\": {
          \"type\": {
            \"type\": \"string\",
            \"enum\": [\"blend\", \"override\", \"replace\"],
            \"description\": \"Extension operation type\"
          },
          \"source\": {
            \"type\": \"string\",
            \"description\": \"Path/URL to extension YAML/JSON\"
          },
          \"merge_keys\": {
            \"type\": \"array\",
            \"items\": { \"type\": \"string\" },
            \"description\": \"Keys for merging (e.g., dialect_id)\",
            \"default\": [\"dialect_id\"]
          },
          \"version\": {
            \"type\": \"string\",
            \"pattern\": \"^v[0-9]+\\.[0-9]+\\.[0-9]+$\"
          },
          \"priority\": {
            \"type\": \"string\",
            \"enum\": [\"user\", \"embedded\"],
            \"default\": \"user\",
            \"description\": \"Priority in conflicts (user wins)\"
          }
        },
        \"additionalProperties\": false
      }
    },
    \"validation\": {
      \"type\": \"object\",
      \"description\": \"Post-blend validation rules\",
      \"properties\": {
        \"required_fields\": {
          \"type\": \"array\",
          \"items\": { \"type\": \"string\" },
          \"default\": [\"dialect_id\", \"patterns\"],
          \"description\": \"Mandatory fields after merge\"
        },
        \"unique_items\": {
          \"type\": \"array\",
          \"items\": { \"type\": \"string\" },
          \"default\": [\"dialect_id\"],
          \"description\": \"Fields that must be unique\"
        },
        \"no_duplicates\": {
          \"type\": \"boolean\",
          \"default\": true,
          \"description\": \"Reject duplicate dialect_ids\"
        }
      },
      \"additionalProperties\": false
    }
  },
  \"additionalProperties\": false
}