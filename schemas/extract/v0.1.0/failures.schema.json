{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sumpter.fulmenhq.dev/extract/v0.1.0/failures.schema.json",
  "title": "Sumpter Extract Failure Manifest",
  "description": "Machine-readable per-input failure summary emitted by extract runs using continue-on-error.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cohort_size",
    "applied",
    "failed",
    "failures"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "extract-failures/v0.1.0"
    },
    "cohort_size": {
      "type": "integer",
      "minimum": 0
    },
    "applied": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 1
    },
    "failures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "disposition",
          "reason",
          "detail"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "const": "failed"
          },
          "reason": {
            "type": "string",
            "enum": [
              "parse_error",
              "signature_mismatch",
              "min_occurrences_violation",
              "validation_error",
              "internal_error"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
