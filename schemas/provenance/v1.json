{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumpterhq.github.io/schemas/provenance/v1.json",
  "title": "Sumpter Provenance Manifest",
  "description": "Canonical sidecar manifest for Sumpter extract provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "sumpter_version",
    "started_at",
    "completed_at",
    "cli",
    "inputs",
    "outputs",
    "counts_by_record_type"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "sumpter.provenance/v1"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "sumpter_version": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "cli": {
      "$ref": "#/$defs/cli"
    },
    "recipe": {
      "$ref": "#/$defs/recipe"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "counts_by_record_type": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "reference_tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference_table"
      }
    },
    "attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "reference_table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "format",
        "mode",
        "row_count",
        "content_sha256",
        "max_rows",
        "max_bytes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "credentials_handle": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "csv",
            "tsv",
            "ndjson"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "membership",
            "lookup"
          ]
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "content_sha256": {
          "type": "string",
          "minLength": 1
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "argv_sanitized"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "argv_sanitized": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manifest_schema_version",
        "content_version",
        "content_hash",
        "signature_yaml",
        "extract_yaml"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "content_version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "owners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/owner"
          }
        },
        "cadence": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "manifest_yaml": {
          "type": "string"
        },
        "signature_yaml": {
          "type": "string"
        },
        "extract_yaml": {
          "type": "string"
        },
        "applicability_yaml": {
          "type": "string"
        },
        "field_provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field_provenance"
          }
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "field_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_field"
      ],
      "oneOf": [
        {
          "required": [
            "xpath"
          ]
        },
        {
          "required": [
            "expression"
          ]
        }
      ],
      "properties": {
        "output_field": {
          "type": "string",
          "minLength": 1
        },
        "xpath": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "transform": {
          "type": "string"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "credentials_handle": {
          "type": "string",
          "description": "Resolved logical credential handle name that authorized acquiring this input. Present only for cloud (s3://) sources. A non-secret indirection label (same logical-identity class as the s3:// path), never the resolved profile, endpoint, region, or secret. Omitted for local/file inputs.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "record_type": {
          "type": "string"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "applied",
            "not_applicable",
            "failed"
          ]
        },
        "disposition_reason": {
          "type": "string",
          "enum": [
            "applicability_predicate_false",
            "signature_mismatch",
            "min_occurrences_violation",
            "parse_error",
            "validation_error",
            "internal_error"
          ]
        },
        "disposition_detail": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format",
        "record_count"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "credentials_handle": {
          "type": "string",
          "description": "Resolved logical credential handle name that authorized publishing this artifact. Present only for cloud (s3://) destinations. A non-secret indirection label (same logical-identity class as the s3:// path), never the resolved profile, endpoint, region, or secret. Omitted for local outputs.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "withhold_columns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
