{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumpterhq.github.io/schemas/provenance/v1.json",
  "title": "Sumpter Provenance Manifest",
  "description": "Canonical sidecar manifest for Sumpter extract provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "sumpter_version",
    "started_at",
    "completed_at",
    "cli",
    "inputs",
    "outputs",
    "counts_by_record_type"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "sumpter.provenance/v1"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "sumpter_version": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "cli": {
      "$ref": "#/$defs/cli"
    },
    "recipe": {
      "$ref": "#/$defs/recipe"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "counts_by_record_type": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "reference_tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference_table"
      }
    },
    "attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "value_profile": {
      "type": "object",
      "description": "Opt-in guarded value-domain diagnostic. Concrete value enumeration is default-deny.",
      "additionalProperties": false,
      "required": ["version", "max_distinct", "small_cell_threshold", "fields"],
      "properties": {
        "version": {
          "type": "string",
          "const": "sumpter.value-profile/v0"
        },
        "max_distinct": {
          "type": "integer",
          "minimum": 1
        },
        "small_cell_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/valueProfileField"
          }
        }
      }
    },
    "output_mode": {
      "type": "string",
      "enum": [
        "aggregate"
      ],
      "description": "Record-file fan-out mode. Present and 'aggregate' when records were streamed to one NDJSON writer per invocation (rolled shards); omitted for the default per-input mode."
    },
    "aggregate_outputs": {
      "type": "array",
      "description": "Per-shard summary in aggregate mode: path, format, record count, content digest, and the contributing input-ordinal span (1-based positions in inputs[]). Completeness is global: the sum of shard record_count equals the sum of inputs[].record_count equals the counts_by_record_type total. Per-shard ordinal spans are not a partition and may overlap by one input at a roll boundary, so they cannot be summed per shard.",
      "items": {
        "$ref": "#/$defs/aggregate_output"
      }
    },
    "incomplete": {
      "type": "boolean",
      "description": "Marks a FAILED aggregate run that had already published one or more cloud shards before failing. Those objects cannot be un-published, so this manifest is written on the failure path to make the committed shards (in aggregate_outputs) discoverable for cleanup or idempotent rerun. Present only on a failed partial run. A manifest carrying incomplete:true must be treated as a failed run, not as successful output."
    },
    "inputs_total": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional input-accounting count: total resolved inputs, equal to len(inputs). Emitted only on aggregate manifests with an authoritative gap-free inputs[] inventory; omitted on per-input/default manifests and on incomplete:true manifests. Reconciliation invariant: inputs_applied + inputs_failed + inputs_not_applicable == inputs_total == len(inputs)."
    },
    "inputs_applied": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional input-accounting count: inputs with disposition 'applied' (including zero-record successes). Counted strictly from inputs[].disposition. Present together with inputs_total/inputs_not_applicable/inputs_failed on aggregate manifests; omitted otherwise."
    },
    "inputs_not_applicable": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional input-accounting count: inputs with disposition 'not_applicable' (skipped by signature/applicability dispatch). One of the three closed top-level dispositions, distinct from a 'failed' min_occurrences miss. Counted strictly from inputs[].disposition; present together with the other input-accounting integers on aggregate manifests."
    },
    "inputs_failed": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional input-accounting count: inputs with disposition 'failed' (including min_occurrences-floor misses, which remain disposition 'failed' with disposition_reason 'min_occurrences_violation' — no separate count). Counted strictly from inputs[].disposition; present together with the other input-accounting integers on aggregate manifests."
    }
  },
  "$defs": {
    "valueProfileField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "status",
        "count",
        "null_count",
        "distinct_count"
      ],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["enumeration", "aggregates"]
        },
        "status": {
          "type": "string",
          "enum": ["complete", "high_cardinality_capped"]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "null_count": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_count": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            {
              "type": "string",
              "pattern": "^(>=|<)[0-9]+$"
            }
          ]
        },
        "distinct": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "shape": {
          "type": "string",
          "enum": [
            "opaque_string",
            "all_numeric",
            "uuid_shaped",
            "email_shaped",
            "freeform"
          ]
        },
        "length": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max", "mean"],
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 },
            "mean": { "type": "number" }
          }
        },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "aggregate_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format",
        "record_count",
        "sha256",
        "input_ordinal_start",
        "input_ordinal_end"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "credentials_handle": {
          "type": "string",
          "description": "Logical credential handle name for a cloud (s3://) shard object; omitted for local outputs. Same non-secret, name-only posture as output.credentials_handle.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Content digest over the fully-written shard file (within-artifact integrity/tamper digest, not a cross-run determinism check)."
        },
        "input_ordinal_start": {
          "type": "integer",
          "minimum": 1,
          "description": "First resolved input ordinal (1-based inputs[] position) that contributed a record to this shard. Adjacent shards' spans may overlap by one input at a roll boundary; this locates coverage, it does not partition inputs."
        },
        "input_ordinal_end": {
          "type": "integer",
          "minimum": 0,
          "description": "Last resolved input ordinal that contributed a record to this shard (0 only for an empty zero-record output)."
        }
      }
    },
    "reference_table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "format",
        "mode",
        "row_count",
        "content_sha256",
        "max_rows",
        "max_bytes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "credentials_handle": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "csv",
            "tsv",
            "ndjson"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "membership",
            "lookup"
          ]
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "content_sha256": {
          "type": "string",
          "minLength": 1
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "argv_sanitized"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "argv_sanitized": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manifest_schema_version",
        "content_version",
        "content_hash",
        "signature_yaml",
        "extract_yaml"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "content_version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "owners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/owner"
          }
        },
        "cadence": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "manifest_yaml": {
          "type": "string"
        },
        "signature_yaml": {
          "type": "string"
        },
        "extract_yaml": {
          "type": "string"
        },
        "applicability_yaml": {
          "type": "string"
        },
        "field_provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field_provenance"
          }
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "field_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_field"
      ],
      "oneOf": [
        {
          "required": [
            "xpath"
          ]
        },
        {
          "required": [
            "expression"
          ]
        }
      ],
      "properties": {
        "output_field": {
          "type": "string",
          "minLength": 1
        },
        "xpath": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "transform": {
          "type": "string"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "credentials_handle": {
          "type": "string",
          "description": "Resolved logical credential handle name that authorized acquiring this input. Present only for cloud (s3://) sources. A non-secret indirection label (same logical-identity class as the s3:// path), never the resolved profile, endpoint, region, or secret. Omitted for local/file inputs.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "record_type": {
          "type": "string"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "applied",
            "not_applicable",
            "failed"
          ]
        },
        "disposition_reason": {
          "type": "string",
          "enum": [
            "applicability_predicate_false",
            "signature_mismatch",
            "min_occurrences_violation",
            "parse_error",
            "validation_error",
            "internal_error"
          ]
        },
        "disposition_detail": {
          "type": "string"
        },
        "record_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of records this input contributed. Recorded only in aggregate output mode; omitted in per-input mode. The input's ordinal is its 1-based position in the manifest inputs[] order."
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format",
        "record_count"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "credentials_handle": {
          "type": "string",
          "description": "Resolved logical credential handle name that authorized publishing this artifact. Present only for cloud (s3://) destinations. A non-secret indirection label (same logical-identity class as the s3:// path), never the resolved profile, endpoint, region, or secret. Omitted for local outputs.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "withhold_columns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
