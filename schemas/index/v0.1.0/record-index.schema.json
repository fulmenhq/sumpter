{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumpter.dev/schemas/index/v0.1.0/record-index.schema.json",
  "title": "Sumpter XML Record Index",
  "description": "Schema for XML record index metadata enabling seekable parallel extraction with integrity verification",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version identifier",
      "const": "record-index/v0.1.0"
    },
    "source": {
      "type": "object",
      "description": "Source XML file information and integrity metadata",
      "properties": {
        "path": {
          "type": "string",
          "description": "Absolute or relative path to the source XML file",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "description": "Total size of source file in bytes",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "description": "SHA-256 hash of the source XML file (hex-encoded, 64 characters)",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compressed": {
          "type": "boolean",
          "description": "Whether the source file is compressed (.gz, .bz2, etc.)"
        },
        "compression_format": {
          "type": "string",
          "description": "Compression format if compressed",
          "enum": [
            "gzip",
            "bzip2",
            "xz",
            "none"
          ]
        },
        "created_at": {
          "type": "string",
          "description": "ISO 8601 timestamp when the index was created",
          "format": "date-time"
        },
        "encoding": {
          "type": "string",
          "description": "Detected character encoding of the source file",
          "examples": [
            "UTF-8",
            "UTF-16LE",
            "ISO-8859-1"
          ]
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256",
        "compressed",
        "created_at"
      ],
      "additionalProperties": false
    },
    "selector": {
      "type": "object",
      "description": "Record selector configuration used to identify record boundaries",
      "properties": {
        "xpath": {
          "type": "string",
          "description": "XPath expression used to identify records (e.g., '//VariationArchive')",
          "minLength": 1
        },
        "element_name": {
          "type": "string",
          "description": "Extracted element name from the XPath selector",
          "minLength": 1
        }
      },
      "required": [
        "xpath",
        "element_name"
      ],
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "description": "Array of record boundary and integrity metadata",
      "items": {
        "type": "object",
        "properties": {
          "record_num": {
            "type": "integer",
            "description": "Sequential record number (1-based)",
            "minimum": 1
          },
          "start_offset": {
            "type": "integer",
            "description": "Byte offset where the record starts in the source file",
            "minimum": 0
          },
          "end_offset": {
            "type": "integer",
            "description": "Byte offset where the record ends in the source file",
            "minimum": 0
          },
          "size_bytes": {
            "type": "integer",
            "description": "Size of the record in bytes",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "description": "SHA-256 hash of the record XML content (hex-encoded)",
            "pattern": "^[a-f0-9]{64}$"
          },
          "element_name": {
            "type": "string",
            "description": "Root element name of this record",
            "minLength": 1
          },
          "depth": {
            "type": "integer",
            "description": "Nesting depth of the record element (1 = top-level)",
            "minimum": 1
          }
        },
        "required": [
          "record_num",
          "start_offset",
          "end_offset",
          "size_bytes",
          "sha256",
          "element_name",
          "depth"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "summary": {
      "type": "object",
      "description": "Summary statistics for the indexed records",
      "properties": {
        "total_records": {
          "type": "integer",
          "description": "Total number of records indexed",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "description": "Total bytes across all records",
          "minimum": 0
        },
        "avg_record_size_bytes": {
          "type": "number",
          "description": "Average record size in bytes",
          "minimum": 0
        },
        "min_record_size_bytes": {
          "type": "integer",
          "description": "Minimum record size in bytes",
          "minimum": 0
        },
        "max_record_size_bytes": {
          "type": "integer",
          "description": "Maximum record size in bytes",
          "minimum": 0
        },
        "p50_record_size_bytes": {
          "type": "integer",
          "description": "Median (50th percentile) record size in bytes",
          "minimum": 0
        },
        "p95_record_size_bytes": {
          "type": "integer",
          "description": "95th percentile record size in bytes",
          "minimum": 0
        },
        "p99_record_size_bytes": {
          "type": "integer",
          "description": "99th percentile record size in bytes",
          "minimum": 0
        }
      },
      "required": [
        "total_records",
        "total_bytes",
        "avg_record_size_bytes",
        "min_record_size_bytes",
        "max_record_size_bytes"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata about the index build process",
      "properties": {
        "generator": {
          "type": "string",
          "description": "Tool and version that generated this index",
          "examples": [
            "sumpter index build v0.1.2"
          ]
        },
        "build_duration_ms": {
          "type": "integer",
          "description": "Time taken to build the index in milliseconds",
          "minimum": 0
        },
        "sumpter_version": {
          "type": "string",
          "description": "Version of Sumpter that created this index"
        }
      },
      "required": [
        "generator"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "source",
    "selector",
    "records",
    "summary",
    "metadata"
  ],
  "additionalProperties": false
}
