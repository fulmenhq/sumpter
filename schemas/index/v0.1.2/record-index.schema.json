{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumpter.dev/schemas/index/v0.1.2/record-index.schema.json",
  "title": "Sumpter XML Record Index",
  "description": "Schema for XML record index metadata enabling seekable source-byte parallel extraction with namespace-context reconstruction",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version identifier",
      "const": "record-index/v0.1.2"
    },
    "source": {
      "type": "object",
      "description": "Source XML file information and integrity metadata",
      "properties": {
        "path": {
          "type": "string",
          "description": "Absolute or relative path to the source XML file",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "description": "Total size of source file in bytes",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "description": "SHA-256 hash of the source XML file (hex-encoded, 64 characters)",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compressed": {
          "type": "boolean",
          "description": "Whether the indexed source file was compressed. Supported seekable offsets require false."
        },
        "compression_format": {
          "type": "string",
          "description": "Compression format if compressed",
          "enum": [
            "gzip",
            "bzip2",
            "xz",
            "none"
          ]
        },
        "offset_kind": {
          "type": "string",
          "description": "Coordinate space for record start/end offsets. Seekable extraction supports source_bytes.",
          "enum": [
            "source_bytes",
            "decompressed_bytes"
          ]
        },
        "created_at": {
          "type": "string",
          "description": "ISO 8601 timestamp when the index was created",
          "format": "date-time"
        },
        "encoding": {
          "type": "string",
          "description": "Detected character encoding of the source file"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256",
        "compressed",
        "offset_kind",
        "created_at"
      ],
      "additionalProperties": false
    },
    "selector": {
      "type": "object",
      "description": "Record selector configuration used to identify record boundaries",
      "properties": {
        "xpath": {
          "type": "string",
          "description": "Local-name record-boundary selector such as 'Record' or '//Record'",
          "minLength": 1
        },
        "element_name": {
          "type": "string",
          "description": "Extracted local element name from the selector",
          "minLength": 1
        }
      },
      "required": [
        "xpath",
        "element_name"
      ],
      "additionalProperties": false
    },
    "namespace_contexts": {
      "type": "array",
      "description": "Deduplicated namespace declarations in scope at indexed record boundaries. Records refer to this table by namespace_context_ref.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Zero-based namespace context identifier",
            "minimum": 0
          },
          "declarations": {
            "type": "array",
            "description": "Namespace declarations in scope for this context. Prefix is empty for the default namespace.",
            "items": {
              "type": "object",
              "properties": {
                "prefix": {
                  "type": "string",
                  "description": "Namespace prefix, or empty string for the default namespace"
                },
                "uri": {
                  "type": "string",
                  "description": "Namespace URI used as an inert XPath match key",
                  "minLength": 1
                }
              },
              "required": [
                "prefix",
                "uri"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "declarations"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "records": {
      "type": "array",
      "description": "Array of record boundary and integrity metadata",
      "items": {
        "type": "object",
        "properties": {
          "record_num": {
            "type": "integer",
            "description": "Sequential record number (1-based)",
            "minimum": 1
          },
          "start_offset": {
            "type": "integer",
            "description": "Byte offset where the record starts in the coordinate space declared by source.offset_kind",
            "minimum": 0
          },
          "end_offset": {
            "type": "integer",
            "description": "Byte offset where the record ends in the coordinate space declared by source.offset_kind",
            "minimum": 0
          },
          "size_bytes": {
            "type": "integer",
            "description": "Size of the record in bytes",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "description": "SHA-256 hash of the record XML content (hex-encoded)",
            "pattern": "^[a-f0-9]{64}$"
          },
          "element_name": {
            "type": "string",
            "description": "Root element local name of this record",
            "minLength": 1
          },
          "depth": {
            "type": "integer",
            "description": "Nesting depth of the record element (1 = top-level)",
            "minimum": 1
          },
          "namespace_context_ref": {
            "type": "integer",
            "description": "Identifier into namespace_contexts for declarations in scope at this record boundary",
            "minimum": 0
          }
        },
        "required": [
          "record_num",
          "start_offset",
          "end_offset",
          "size_bytes",
          "sha256",
          "element_name",
          "depth",
          "namespace_context_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "summary": {
      "type": "object",
      "description": "Summary statistics for the indexed records",
      "properties": {
        "total_records": {
          "type": "integer",
          "description": "Total number of records indexed",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "description": "Total bytes across all records",
          "minimum": 0
        },
        "avg_record_size_bytes": {
          "type": "number",
          "description": "Average record size in bytes",
          "minimum": 0
        },
        "min_record_size_bytes": {
          "type": "integer",
          "description": "Minimum record size in bytes",
          "minimum": 0
        },
        "max_record_size_bytes": {
          "type": "integer",
          "description": "Maximum record size in bytes",
          "minimum": 0
        },
        "p50_record_size_bytes": {
          "type": "integer",
          "description": "Median (50th percentile) record size in bytes",
          "minimum": 0
        },
        "p95_record_size_bytes": {
          "type": "integer",
          "description": "95th percentile record size in bytes",
          "minimum": 0
        },
        "p99_record_size_bytes": {
          "type": "integer",
          "description": "99th percentile record size in bytes",
          "minimum": 0
        }
      },
      "required": [
        "total_records",
        "total_bytes",
        "avg_record_size_bytes",
        "min_record_size_bytes",
        "max_record_size_bytes"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata about the index build process",
      "properties": {
        "generator": {
          "type": "string",
          "description": "Tool and version that generated this index"
        },
        "build_duration_ms": {
          "type": "integer",
          "description": "Time taken to build the index in milliseconds",
          "minimum": 0
        },
        "sumpter_version": {
          "type": "string",
          "description": "Version of Sumpter that created this index"
        }
      },
      "required": [
        "generator"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "source",
    "selector",
    "namespace_contexts",
    "records",
    "summary",
    "metadata"
  ],
  "additionalProperties": false
}
