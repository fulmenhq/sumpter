{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumpterhq.github.io/schemas/provenance/v1.json",
  "title": "Sumpter Provenance Manifest",
  "description": "Canonical sidecar manifest for Sumpter extract provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "sumpter_version",
    "started_at",
    "completed_at",
    "cli",
    "inputs",
    "outputs",
    "counts_by_record_type"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "sumpter.provenance/v1"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "sumpter_version": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "cli": {
      "$ref": "#/$defs/cli"
    },
    "recipe": {
      "$ref": "#/$defs/recipe"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "counts_by_record_type": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "argv_sanitized"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "argv_sanitized": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manifest_schema_version",
        "content_version",
        "content_hash",
        "signature_yaml",
        "extract_yaml"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "content_version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "owners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/owner"
          }
        },
        "manifest_yaml": {
          "type": "string"
        },
        "signature_yaml": {
          "type": "string"
        },
        "extract_yaml": {
          "type": "string"
        },
        "field_provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field_provenance"
          }
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "field_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_field"
      ],
      "oneOf": [
        {
          "required": [
            "xpath"
          ]
        },
        {
          "required": [
            "expression"
          ]
        }
      ],
      "properties": {
        "output_field": {
          "type": "string",
          "minLength": 1
        },
        "xpath": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "transform": {
          "type": "string"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "record_type": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format",
        "record_count"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "withhold_columns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
