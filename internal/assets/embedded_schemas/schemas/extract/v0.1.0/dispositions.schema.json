{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumpter.dev/schemas/extract/v0.1.0/dispositions.schema.json",
  "title": "Sumpter Extract Disposition Summary",
  "description": "Machine-readable per-input applicability disposition summary emitted by extract runs that declare recipe applicability gates.",
  "type": "object",
  "required": [
    "schema_version",
    "cohort_size",
    "applied",
    "not_applicable",
    "failed",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "extract-dispositions/v0.1.0"
    },
    "cohort_size": {
      "type": "integer",
      "minimum": 0
    },
    "applied": {
      "type": "integer",
      "minimum": 0
    },
    "not_applicable": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "disposition"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "applied",
              "not_applicable",
              "failed"
            ]
          },
          "disposition_reason": {
            "type": "string",
            "enum": [
              "applicability_predicate_false",
              "signature_mismatch",
              "min_occurrences_violation",
              "parse_error",
              "validation_error",
              "internal_error"
            ]
          },
          "disposition_detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
