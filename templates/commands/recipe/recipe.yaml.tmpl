version: "recipe/v0.1.0"
kind: "extract"
id: {{if .RecipeID}}{{.RecipeID}}{{else}}your-recipe-id{{end}}
display_name: ""
description: ""
created_at: "{{.CreatedAt}}"
# content_version is the SemVer of the recipe's extraction content
# (signature + extract assets). Bump on every change that alters extracted
# records. Provenance records this as `recipe_version`. See ADR-0006.
content_version: "0.0.1"
owners:
  - name: ""
    contact: ""
documentation:
  overview: README.md
assets:
  signature: signature/example-signature.yaml
  extract: extract/example-extract.yaml
  validation: ""
  extras: []
defaults:
  input:
    mode: path
    path: testdata
    include_pattern: "*.xml"
    exclude_pattern: ""
    max_depth: 0
    follow_symlinks: false
    files: []
  output:
    format: json
    path: outputs
    pattern: extract-{}.json
  client_id: ""
  site_id: ""
  parameters:
    # Inject operator-known fields into every extracted record.
    # Use for identifiers the consumer needs but the source data lacks.
    # NOTE: parameter keys must NOT collide with
    # field_mappings[].output_field; recipe load fails on collision.
    region_id: "westcoast"
    tenant_id: "1234"
  parameters_required:
    # Listed parameters MUST resolve at recipe load (from defaults above
    # OR from CLI --parameter key=value). Recipe load fails if any required
    # key has no value.
    - tenant_id
  source_extraction:
    # Extract file-level fields once per source file. Named captures become
    # record fields before defaults.parameters and CLI --parameter overrides.
    - id: filename-date-token
      source: filename
      pattern: '^(?P<business_date>\d{4}-\d{2}-\d{2})-.*\.xml$'
    - id: path-site-identifier
      source: relative_path
      pattern: '^sites/(?P<source_site_id>[a-z0-9-]+)/'
  source_extraction_required:
    - business_date
  workers: 1
  progress: false
notes: ""
